# ==========================================
# 1. Inteligência Artificial & Telegram
# ==========================================
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ==========================================
# 2. Configurações da UI / Pet Shimeji
# ==========================================
PET_SIZE=128
PET_GRAVITY=0.9
PET_WALK_SPEED=1.6
PET_ANCHOR_X=1.0
PET_ANCHOR_Y=1.0
PET_FOLLOW_SCREEN=1
PET_MONITOR_POLL_MS=400

# ==========================================
# 3. Rede Multi-Máquinas (Hub WebSocket)
# ==========================================
# Modos:
# standalone: uso local individual
# hub: máquina principal (Hub WebSocket + Telegram Bot)
# node: máquina secundária conectada ao Hub (Notebook, etc.)
CECILIA_MODE=standalone
CECILIA_NODE_ID=
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
CECILIA_HUB_SECRET=
CECILIA_HUB_HOST=0.0.0.0
CECILIA_HUB_PORT=8765

# Preencha apenas nas máquinas secundárias (modo node):
# Exemplo local: ws://192.168.1.X:8765/ws
# Exemplo internet pública: wss://seu-dominio-ou-tunnel.com/ws
CECILIA_HUB_URL=
